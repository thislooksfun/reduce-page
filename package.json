{
  "name": "reduce-page",
  "version": "0.4.3",
  "description": "Reduce a webpage to find the smallest test case",
  "bin": "dist/cli.js",
  "type": "module",
  "author": "thislooksfun <tlf@thislooks.fun> (https://thislooks.fun)",
  "license": "MIT",
  "repository": "https://github.com/thislooksfun/reduce-page",
  "bugs": "https://github.com/thislooksfun/reduce-page/issues",
  "homepage": "https://github.com/thislooksfun/reduce-page",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "is-ci || husky",
    "dev": "tsx src/cli.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli wm",
    "lint": "npm run lint:check",
    "lint:check": "npm-run-all lint:check:*",
    "lint:check:eslint": "eslint",
    "lint:check:prettier": "prettier --check \"**/*\"",
    "lint:fix": "npm-run-all lint:fix:*",
    "lint:fix:eslint": "eslint --fix",
    "lint:fix:prettier": "prettier --write \"**/*\""
  },
  "dependencies": {
    "chalk": "5.6.2",
    "debug": "4.4.3",
    "express": "5.2.1",
    "livereload": "0.10.3",
    "parse5": "8.0.0",
    "postcss": "8.5.6",
    "purgecss": "7.0.2",
    "strip-bom": "5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@commitlint/types": "20.5.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "9.39.5",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/livereload": "0.9.5",
    "@types/node": "24.13.3",
    "del-cli": "7.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-comment-length": "2.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "16.4.0",
    "nock": "14.0.17",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "keywords": []
}
